# ==============================================================================
# Cloud-Based Image Gallery - Environment Configuration Template
# Copy this file to .env and customize for your deployment or local run.
# WARNING: NEVER commit your actual .env file or GCP service account keys to git!
# ==============================================================================

# Flask Session Security
SECRET_KEY=change-this-to-a-very-secure-random-key-in-production

# Google Cloud Platform Configuration
GCP_PROJECT_ID=your-gcp-project-id
GCS_BUCKET_NAME=your-unique-gallery-bucket-name

# Role-Based Authentication Credentials
# In production, store these in Google Cloud Secret Manager or Cloud Run env vars.
ADMIN_PASSWORD=admin123
VIEWER_PASSWORD=viewer123

# Local Development Settings
# Set to 'true' to run fully offline using a local mock storage directory,
# or 'false' to connect to real Google Cloud Storage.
LOCAL_STORAGE_MODE=false

# Google Cloud Authentication (FOR LOCAL DEVELOPMENT ONLY)
# On Cloud Run, LEAVE THIS EMPTY. Cloud Run automatically uses the attached service account.
# Locally, generate a key for 'gallery-app-sa' and provide the absolute path:
# GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\service-account-key.json

# Server Port (Cloud Run injects PORT automatically, defaults to 8080)
PORT=8080
