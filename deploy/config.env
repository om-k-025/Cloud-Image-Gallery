# ==============================================================================
# GCP DEPLOYMENT CONFIGURATION
# Fill in your project details before running deployment scripts.
# ==============================================================================

# Your Google Cloud Project ID (must be an active project with billing enabled)
PROJECT_ID="your-project-id"

# GCP Deployment Region (us-central1 is free-tier eligible for Cloud Run & GCS)
REGION="us-central1"

# Unique Cloud Storage Bucket Name (GCS bucket names are globally unique)
# Recommended: gallery-bucket-<your-project-id>
BUCKET_NAME="gallery-bucket-${PROJECT_ID}"

# Dedicated Service Account Name
SERVICE_ACCOUNT_NAME="gallery-app-sa"
TEST_VIEWER_SA_NAME="gallery-test-viewer-sa"

# Cloud Run Service Name
SERVICE_NAME="cloud-image-gallery"

# Your email address for Cloud Monitoring uptime alerts
NOTIFICATION_EMAIL="your-email@example.com"

# Demo Application Passwords
APP_ADMIN_PASSWORD="admin_secure_pass_123"
APP_VIEWER_PASSWORD="viewer_guest_pass_123"
APP_SECRET_KEY="cloud-gallery-secret-key-prod-random-seed"
